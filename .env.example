# Database
DATABASE_URL="file:/app/data/dev.db"

# NextAuth Configuration
# Local Docker: http://localhost:3000
# Production (Traefik/Cloudflare): https://permitpro.permitpro.icu
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="your-secret-key-here"

# File Storage
STORAGE_ROOT="/app/storage"

# Traefik/Let's Encrypt
ACME_EMAIL="admin@yourdomain.com"

# Cloudflare Tunnel — connector token from Zero Trust → Networks → Tunnels → Configure
# Ingress hostnames/services are managed in the Cloudflare dashboard, not in this repo.
CLOUDFLARE_TUNNEL_TOKEN="your-tunnel-token-here"

# ── AI Integration ────────────────────────────────────────────────────────────
# Provider: "anthropic" (default) or "gemini"
AI_PROVIDER="anthropic"

# Anthropic Claude — https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY="sk-ant-..."
# Optional model override (default: claude-sonnet-4-6)
# ANTHROPIC_MODEL="claude-sonnet-4-6"

# Google Gemini — https://aistudio.google.com/apikey
GOOGLE_AI_API_KEY="AIza..."
# Optional model override (default: gemini-2.0-flash)
# GEMINI_MODEL="gemini-2.0-flash"
