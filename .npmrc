# Filesystems that forbid symlinks (common under /media/... exFAT/USB) break:
# 1) npm's node_modules/.bin links → bin-links=false fixes that step.
# 2) node-gyp building native addons (e.g. better-sqlite3) → still creates symlinks
#    under node_modules/.../build/ — that fails on the same volume.
#
# If `npm install` still errors with EPERM symlink: clone or copy this repo to a
# Linux native filesystem (e.g. ~/code on ext4) and run npm install there; or use
# Node 20 LTS so better-sqlite3 can use a prebuilt binary and skip compiling.
bin-links=false
